@model IEnumerable<RaceDayy.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<h1>Categories for: @ViewBag.EventName</h1>
<partial name="_Alerts" />

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Add New Category</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" name="EventID" value="@ViewBag.EventId" />

                    <div class="mb-3">
                        <label class="form-label">Category Name (e.g. 42km Male)</label>
                        <input name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input name="DistanceKm" type="number" step="0.1" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entry Fee (R)</label>
                        <input name="EntryFee" type="number" step="0.1" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Category</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <h4>Existing Categories</h4>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Distance</th>
                    <th>Fee</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.CategoryName</td>
                        <td>@cat.DistanceKm km</td>
                        <td>R @cat.EntryFee</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@cat.CategoryID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this category?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <a asp-controller="EventsMvc" asp-action="Index" class="btn btn-secondary mt-3">Back to Events</a>
    </div>
</div>