@model IEnumerable<RaceDayy.Models.Enrollment>

@{
    ViewData["Title"] = "My Enrollments";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h1 class="fw-bold" style="color: #0f2027;">My Enrollments</h1>
    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Browse More Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mt-3">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark" style="background-color: #203a43;">
                <tr>
                    <th class="py-3 px-4">Event Name</th>
                    <th class="py-3">Category</th>
                    <th class="py-3">Date Enrolled</th>
                    <th class="py-3">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 fw-bold">@item.Category?.Event?.EventName</td>
                            <td class="py-3">@item.Category?.CategoryName</td>
                            <td class="py-3">@item.EnrollmentDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="py-3">
                                <!-- Colour-coded status logic -->
                                @if (item.Status == "Registered" || item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success px-3 py-2">@item.Status</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <h5>You haven't enrolled in any events yet.</h5>
                            <p>Click "Browse More Events" to find your next race!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>