@model RaceDayy.Models.ViewModels.OrganizerDashboardViewModel

@{
    ViewData["Title"] = "Organizer Dashboard";
}

<h1>Organizer Dashboard</h1>
<p class="text-muted">Overview of your events and enrolments.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Events</h5>
                <p class="card-text display-4">@Model.TotalEvents</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Categories</h5>
                <p class="card-text display-4">@Model.TotalCategories</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Enrolments</h5>
                <p class="card-text display-4">@Model.TotalEnrollments</p>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4">My Events</h3>

@if (Model.Events.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Status</th>
                <th>Categories</th>
                <th>Enrolments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model.Events)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@ev.Status</td>
                    <td>@ev.CategoryCount</td>
                    <td>@ev.EnrollmentCount</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">You have not created any events yet.</p>
}

<a asp-controller="Events" asp-action="Create" class="btn btn-primary">Create New Event</a>