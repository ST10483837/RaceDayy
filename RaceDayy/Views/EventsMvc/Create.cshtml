@model RaceDayy.Models.Event

@{
    ViewData["Title"] = "Create event";
}

<h1>Create event</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="EventName" class="control-label">Name</label>
                <input asp-for="EventName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EventDate" class="control-label">Date</label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" required />
            </div>

            <!-- Note: We are using a simple text input for location for now to match the screenshot -->
            <div class="form-group mb-3">
                <label class="control-label">Location (Temporary)</label>
                <input type="text" class="form-control" placeholder="e.g. Gateway Gate 1 entrance" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Distance" class="control-label">Distance (km)</label>
                <input asp-for="Distance" class="form-control" type="number" step="0.1" required />
            </div>
            <div class="form-group mb-3">
                <label asp-for="EventType" class="control-label">Event type</label>
                <select asp-for="EventType" class="form-control">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>