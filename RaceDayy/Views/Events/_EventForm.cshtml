@model RaceDayy.Models.Event

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group mb-3">
    <label asp-for="EventName" class="control-label">Name</label>
    <input asp-for="EventName" class="form-control" required />
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Description" class="control-label">Description</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="EventDate" class="control-label">Date</label>
    <input asp-for="EventDate" type="datetime-local" class="form-control" required />
    <span asp-validation-for="EventDate" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Distance" class="control-label">Distance (km)</label>
    <input asp-for="Distance" class="form-control" type="number" step="0.1" required />
    <span asp-validation-for="Distance" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="EventType" class="control-label">Event type</label>
    <select asp-for="EventType" class="form-control">
        <option value="Run">Run</option>
        <option value="Walk">Walk</option>
        <option value="Cycle">Cycle</option>
    </select>
    <span asp-validation-for="EventType" class="text-danger"></span>
</div>